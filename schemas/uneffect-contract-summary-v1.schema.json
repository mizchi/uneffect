{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mizchi/uneffect/schemas/uneffect-contract-summary-v1.schema.json",
  "title": "Uneffect persisted scalar contract summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package", "compiler", "producer", "exports", "contentDigest"],
  "properties": {
    "schema": { "const": "uneffect-contract-summary/v1" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typescriptVersion", "compilerOptionsDigest"],
      "properties": {
        "typescriptVersion": { "type": "string", "minLength": 1 },
        "compilerOptionsDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sourceDigest"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticModule" }
    },
    "runtimeArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packagePath", "digest"],
        "properties": {
          "packagePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$" },
          "digest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "typescriptEmit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "packagePath", "digest"],
            "properties": {
              "kind": { "enum": ["declaration", "runtime"] },
              "packagePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$" },
              "digest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "functionName", "evidence", "declarationSpan", "declarationDigest", "signature", "signatureDigest", "parameters", "requires", "ensures", "artifactIds"],
        "properties": {
          "symbol": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "export"],
            "properties": {
              "module": { "type": "string", "minLength": 1 },
              "export": { "type": "string", "minLength": 1 }
            }
          },
          "functionName": { "type": "string", "minLength": 1 },
          "evidence": { "const": "verified" },
          "declarationSpan": { "$ref": "#/$defs/span" },
          "declarationDigest": { "$ref": "#/$defs/sha256" },
          "signature": { "type": "string", "minLength": 1 },
          "signatureDigest": { "$ref": "#/$defs/sha256" },
          "parameters": { "type": "array", "items": { "type": "string" } },
          "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "ensures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "artifactIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileName", "sourceDigest"],
            "properties": {
              "fileName": { "type": "string", "minLength": 1 },
              "sourceDigest": { "$ref": "#/$defs/sha256" }
            }
          },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effects", "parameters"],
            "properties": {
              "effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "parameters": { "type": "array", "items": { "type": "string" } },
              "rejects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "returnCallable": {
                "type": "object",
                "additionalProperties": false,
                "required": ["effects", "evidence"],
                "properties": {
                  "effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "rejects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "evidence": { "enum": ["inferred", "trusted", "verified"] }
                }
              },
              "returnMembers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["key", "effects", "evidence"],
                  "properties": {
                    "key": { "type": "string", "minLength": 1 },
                    "effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "rejects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "parameters": { "type": "array", "items": { "type": "string" } },
                    "callbacks": { "type": "array", "items": { "$ref": "#/$defs/callback" } },
                    "returnsReceiver": { "type": "boolean" },
                    "evidence": { "enum": ["inferred", "trusted", "verified"] }
                  }
                }
              },
              "callbacks": {
                "type": "array",
                "items": { "$ref": "#/$defs/callback" }
              }
            }
          },
          "resource": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence", "operations"],
            "properties": {
              "evidence": { "const": "trusted" },
              "operations": { "type": "array", "items": { "$ref": "#/$defs/resourceOperation" } },
              "returnMembers": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["key", "operations"],
                  "properties": {
                    "key": { "type": "string", "minLength": 1 },
                    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resourceOperation" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "contentDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semanticModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "namespace", "evidence", "trustOwner", "trustReason", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "evidence": { "const": "trusted" },
        "trustOwner": { "type": "string", "minLength": 1 },
        "trustReason": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "cardinality", "timing", "completion"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "path": {
          "type": "array",
          "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] }
        },
        "containerAccess": { "const": "borrow-readonly" },
        "cardinality": { "enum": ["0", "0..1", "exactly-1", "0..n", "unknown"] },
        "timing": { "enum": ["inline", "deferred", "promise-reaction", "unknown"] },
        "completion": { "enum": ["propagate-throw", "convert-throw-to-rejection", "host-report-throw", "unknown"] },
        "schedulingSource": { "enum": ["setTimeout", "setInterval", "requestAnimationFrame", "EventTarget.prototype.addEventListener"] },
        "schedulingDelay": { "type": "number", "minimum": 0 },
        "effectBound": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "resourceReference": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "return" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "receiver" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "index"], "properties": {
          "kind": { "const": "parameter" }, "index": { "type": "integer", "minimum": 0 }, "name": { "type": "string" }
        } }
      ]
    },
    "resourceOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "subject"],
      "properties": {
        "kind": { "enum": ["acquire", "use", "borrow", "consume", "release", "transfer", "escape"] },
        "subject": { "$ref": "#/$defs/resourceReference" },
        "target": { "$ref": "#/$defs/resourceReference" }
      }
    }
  }
}
