{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mizchi/uneffect/blob/main/schemas/uneffect-workspace-check-v1.schema.json",
  "title": "Uneffect workspace check decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "outcome", "rootProjectFile", "references", "buildOrder", "buildArtifacts", "outputIntegrity", "configs", "projects", "effectComposition", "refinementComposition", "blockers", "assurance"],
  "properties": {
    "schema": { "const": "uneffect-workspace-check/v1" },
    "outcome": { "enum": ["passed", "failed"] },
    "rootProjectFile": { "type": "string" },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "buildOrder": { "type": "array", "items": { "type": "string" } },
    "buildArtifacts": { "$ref": "#/$defs/buildArtifacts" },
    "outputIntegrity": { "$ref": "#/$defs/outputIntegrity" },
    "configs": { "type": "array", "items": { "$ref": "#/$defs/config" } },
    "projects": { "type": "array", "items": { "$ref": "./uneffect-check-v1.schema.json" } },
    "effectComposition": { "$ref": "#/$defs/effectComposition" },
    "refinementComposition": { "$ref": "#/$defs/refinementComposition" },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "assurance": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/assurance" }] }
  },
  "$defs": {
    "effectComposition": {
      "type": "object", "additionalProperties": false, "required": ["status", "links", "blockers"],
      "properties": {
        "status": { "enum": ["not-applicable", "verified", "unknown"] },
        "links": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "fromProject", "toProject", "callerFile", "callee", "declarationFile", "evidence", "effects", "declarationIntegrity"],
          "properties": {
            "kind": { "enum": ["function", "module"] },
            "fromProject": { "type": "string" }, "toProject": { "type": "string" },
            "callerFile": { "type": "string" }, "callee": { "type": "string" },
            "declarationFile": { "type": "string" },
            "parameters": { "type": "array", "items": { "type": "string" } },
            "iteratorEffectParameters": { "type": "array", "items": { "$ref": "#/$defs/iteratorEffectParameter" } },
            "iteratorEffectBounds": { "type": "array", "items": { "$ref": "#/$defs/iteratorEffectBound" } },
            "mutationRoots": { "type": "array", "items": { "$ref": "#/$defs/mutationRoot" } },
            "declarationIntegrity": { "$ref": "#/$defs/declarationIntegrity" },
            "evidence": { "enum": ["verified", "trusted", "inferred", "unknown"] },
            "effects": { "type": "array", "items": { "type": "string" } }
          }
        } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
      }
    },
    "refinementComposition": {
      "type": "object", "additionalProperties": false, "required": ["status", "links", "blockers"],
      "properties": {
        "status": { "enum": ["not-applicable", "verified", "unknown"] },
        "links": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["fromProject", "toProject", "callerFile", "callee", "adapterName", "version", "modelName", "callPath", "helperDepthBudget", "evidence", "declarationFile", "declarationIntegrity", "producer", "consumer"],
          "properties": {
            "fromProject": { "type": "string" }, "toProject": { "type": "string" },
            "callerFile": { "type": "string" }, "callee": { "type": "string" },
            "adapterName": { "type": "string" }, "version": { "type": "string" },
            "modelName": { "type": "string" }, "evidence": { "enum": ["verified", "unknown"] },
            "callPath": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
            "helperDepthBudget": { "type": "integer", "const": 2 },
            "runtimeIdentity": { "$ref": "#/$defs/sameRealmGlobalThisIdentity" },
            "guard": { "type": "string" },
            "declarationFile": { "type": "string" },
            "declarationIntegrity": { "$ref": "#/$defs/declarationIntegrity" },
            "producer": { "$ref": "#/$defs/provenance" }, "consumer": { "$ref": "#/$defs/provenance" }
          }
        } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
      }
    },
    "iteratorEffectParameter": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "name", "convertsThrowToRejection"],
      "properties": { "index": { "type": "integer", "minimum": 0 }, "name": { "type": "string" }, "convertsThrowToRejection": { "type": "boolean" } }
    },
    "iteratorEffectBound": {
      "type": "object", "additionalProperties": false, "required": ["index", "name", "effects"],
      "properties": { "index": { "type": "integer", "minimum": 0 }, "name": { "type": "string" }, "effects": { "type": "array", "items": { "type": "string" } } }
    },
    "mutationRoot": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "root", "exportName", "identity"],
          "properties": { "kind": { "const": "export" }, "root": { "type": "string" }, "exportName": { "type": "string" }, "identity": { "type": "string" } }
        },
        { "$ref": "#/$defs/sameRealmGlobalThisIdentity" }
      ]
    },
    "sameRealmGlobalThisIdentity": {
      "type": "object", "additionalProperties": false, "required": ["kind", "root", "identity"],
      "properties": { "kind": { "const": "ambient" }, "root": { "const": "globalThis" }, "identity": { "const": "ecmascript:realm.globalThis" } }
    },
    "declarationIntegrity": {
      "type": "object", "additionalProperties": false, "required": ["status", "fileName"],
      "properties": {
        "status": { "enum": ["verified", "missing", "mismatch", "error"] }, "fileName": { "type": "string" },
        "expectedDigest": { "type": "string" }, "actualDigest": { "type": "string" }, "message": { "type": "string" },
        "transform": { "$ref": "#/$defs/declarationTransformEvidence" }
      }
    },
    "declarationTransformEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "profile", "transform", "sourceFile", "generatedFile", "sourceSpan", "sourceDigest", "generatedDigest", "compilerVersion", "status"],
      "properties": {
        "schema": { "const": "uneffect-declaration-transform-evidence/v1" },
        "profile": { "const": "embedded-typescript/v1" },
        "transform": {
          "type": "object", "additionalProperties": false, "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "sourceFile": { "type": "string" }, "generatedFile": { "type": "string" },
        "sourceSpan": {
          "type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } }
        },
        "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generatedDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "compilerVersion": { "type": "string" }, "status": { "const": "verified" }
      }
    },
    "buildArtifacts": {
      "type": "object", "additionalProperties": false, "required": ["status", "observations"],
      "properties": {
        "status": { "enum": ["fresh", "stale", "unknown"] },
        "observations": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": { "code": { "type": "integer" }, "message": { "type": "string" } }
        } }
      }
    },
    "outputIntegrity": {
      "type": "object", "additionalProperties": false, "required": ["status", "outputs"],
      "properties": {
        "status": { "enum": ["not-checked", "verified", "missing", "mismatch", "error"] },
        "message": { "type": "string" },
        "outputs": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "status", "fileName", "expectedDigest"],
          "properties": {
            "kind": { "enum": ["declaration", "runtime"] }, "status": { "enum": ["verified", "missing", "mismatch"] },
            "fileName": { "type": "string" }, "projectFile": { "type": "string" }, "expectedDigest": { "type": "string" }, "actualDigest": { "type": "string" }, "message": { "type": "string" }
          }
        } }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["analyzerVersion", "analyzerPackageFile", "consumerVersion", "consumerPackageFile", "consumerModuleFile", "parity"],
      "properties": {
        "analyzerVersion": { "type": "string" }, "analyzerPackageFile": { "type": "string" },
        "consumerVersion": { "type": ["string", "null"] }, "consumerPackageFile": { "type": ["string", "null"] },
        "consumerModuleFile": { "type": ["string", "null"] }, "parity": { "enum": ["exact", "mismatch", "unknown"] },
        "reason": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["projectFile", "compiler"],
      "properties": { "projectFile": { "type": "string" }, "compiler": { "$ref": "#/$defs/compiler" } }
    },
    "config": {
      "type": "object", "additionalProperties": false, "required": ["projectFile", "compiler", "rootFiles"],
      "properties": {
        "projectFile": { "type": "string" }, "compiler": { "$ref": "#/$defs/compiler" },
        "rootFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "blocker": {
      "type": "object", "additionalProperties": false, "required": ["kind", "classification", "projectFile", "message"],
      "properties": {
        "kind": { "type": "string" }, "classification": { "enum": ["unknown", "violation"] },
        "projectFile": { "type": "string" }, "message": { "type": "string" },
        "reference": { "type": "string" }, "subject": { "type": "string" }
      }
    },
    "assurance": {
      "type": "object", "additionalProperties": false,
      "allOf": [{
        "if": { "properties": { "passed": { "const": false } }, "required": ["passed"] },
        "then": { "properties": { "claims": { "maxItems": 0 } } }
      }],
      "required": ["profile", "status", "passed", "blockers", "claims", "exclusions"],
      "properties": {
        "profile": { "enum": ["no-unknown", "declared", "verified"] },
        "status": { "enum": ["verified", "assumed", "unknown", "violated"] },
        "passed": { "type": "boolean" }, "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "claims": { "type": "array", "items": { "type": "string" } },
        "exclusions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
