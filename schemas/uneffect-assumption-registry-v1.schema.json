{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mizchi.github.io/uneffect/schemas/uneffect-assumption-registry-v1.schema.json",
  "title": "Uneffect assumption registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records"],
  "properties": {
    "schema": { "const": "uneffect-assumption-registry/v1" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "reason", "owner", "reviewDigest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "domain": { "enum": ["builtin", "module-initialization", "typed-array", "temporal-contract", "dispatch-sealing", "resource-callable", "package-contract"] },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "expiresOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "reviewDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
