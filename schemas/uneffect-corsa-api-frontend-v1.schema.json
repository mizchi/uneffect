{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mizchi/uneffect/blob/main/schemas/uneffect-corsa-api-frontend-v1.schema.json",
  "title": "Uneffect Corsa API frontend descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "compiler", "project", "capabilities", "limitations"],
  "properties": {
    "schema": { "const": "uneffect-corsa-api-frontend/v1" },
    "contract": { "const": "semantic-query" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "executable"],
      "properties": {
        "revision": { "type": "string", "pattern": "^corsa-api@" },
        "executable": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "configFile", "rootFiles"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "configFile": { "type": "string", "minLength": 1 },
        "rootFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "position-query",
          "batch-position-query",
          "alias-query",
          "module-exports-query",
          "type-property-query",
          "type-symbol-query",
          "assignability-query",
          "bounded-builtin-classification"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["syntax-out-of-band", "builtin-classification-bounded"] }
    }
  }
}
