{
  "name": "@mizchi/uneffect",
  "version": "0.0.0-alpha.0",
  "description": "Static effect, contract, and async-safety checking for existing TypeScript, driven by /* uneffect: ... */ comments.",
  "keywords": [
    "typescript",
    "effects",
    "static-analysis",
    "verification",
    "hoare-logic",
    "z3",
    "quint",
    "cli"
  ],
  "homepage": "https://github.com/mizchi/uneffect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/uneffect.git"
  },
  "bugs": {
    "url": "https://github.com/mizchi/uneffect/issues"
  },
  "license": "MIT",
  "author": "mizchi",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./corsa": {
      "types": "./dist/src/corsa-checker-exporter.d.ts",
      "import": "./dist/src/corsa-checker-exporter.js"
    }
  },
  "bin": {
    "uneffect": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "docs",
    "schemas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "tsx ci/run-test-tiers.ts",
    "bench": "vitest bench --run",
    "check": "tsc -p tsconfig.json --noEmit && tsx ci/run-test-tiers.ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@informalsystems/quint": ">=0.32.0",
    "@oxlint/plugins": ">=1.80.0",
    "corsa-oxlint": ">=1.12.4",
    "oxlint": ">=1.80.0",
    "typescript": ">=6.0.0-dev.20260820"
  },
  "peerDependenciesMeta": {
    "@informalsystems/quint": {
      "optional": true
    },
    "@oxlint/plugins": {
      "optional": true
    },
    "corsa-oxlint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "dependencies": {
    "effect": "^3.22.1",
    "valibot": "^1.4.2",
    "z3-solver": "^4.15.4"
  },
  "devDependencies": {
    "@informalsystems/quint": "^0.32.0",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "corsa-oxlint": "1.12.4",
    "oxlint": "1.80.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0-dev.20260820",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.15.0"
}
