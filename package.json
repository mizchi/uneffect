{
  "name": "@mizchi/uneffect",
  "version": "0.3.0",
  "description": "Gradual effect, contract, async-safety, and temporal checking for existing TypeScript through comments.",
  "keywords": [
    "typescript",
    "effects",
    "static-analysis",
    "verification",
    "hoare-logic",
    "temporal-logic",
    "trusted-types",
    "z3",
    "quint",
    "cli"
  ],
  "homepage": "https://github.com/mizchi/uneffect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/uneffect.git"
  },
  "bugs": {
    "url": "https://github.com/mizchi/uneffect/issues"
  },
  "license": "MIT",
  "author": "mizchi",
  "type": "module",
  "main": "./dist/src/api/public.js",
  "types": "./dist/src/api/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/api/public.d.ts",
      "import": "./dist/src/api/public.js"
    },
    "./corsa": {
      "types": "./dist/src/api/corsa-public.d.ts",
      "import": "./dist/src/api/corsa-public.js"
    },
    "./corsa/api": {
      "types": "./dist/src/frontends/corsa/corsa-api-frontend.d.ts",
      "import": "./dist/src/frontends/corsa/corsa-api-frontend.js"
    },
    "./experimental": {
      "types": "./dist/src/api/experimental.d.ts",
      "import": "./dist/src/api/experimental.js"
    },
    "./experimental/corsa": {
      "types": "./dist/src/api/corsa-experimental.d.ts",
      "import": "./dist/src/api/corsa-experimental.js"
    },
    "./spec": {
      "types": "./dist/src/spec/index.d.ts",
      "import": "./dist/src/spec/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json",
    "./cfg": {
      "types": "./dist/src/cfg/index.d.ts",
      "import": "./dist/src/cfg/index.js"
    },
    "./workflow": {
      "types": "./dist/src/graph-analysis/workflow-api.d.ts",
      "import": "./dist/src/graph-analysis/workflow-api.js"
    },
    "./impact": {
      "types": "./dist/src/graph-analysis/impact-api.d.ts",
      "import": "./dist/src/graph-analysis/impact-api.js"
    },
    "./module-order": {
      "types": "./dist/src/modules/module-order-api.d.ts",
      "import": "./dist/src/modules/module-order-api.js"
    },
    "./experimental/lint": {
      "types": "./dist/src/lint/index.d.ts",
      "import": "./dist/src/lint/index.js"
    },
    "./experimental/lint/corsa": {
      "types": "./dist/src/lint/corsa.d.ts",
      "import": "./dist/src/lint/corsa.js"
    },
    "./experimental/spec": {
      "types": "./dist/src/spec/analysis-api.d.ts",
      "import": "./dist/src/spec/analysis-api.js"
    },
    "./experimental/instrument": {
      "types": "./dist/src/optimizer/runtime-assertions.d.ts",
      "import": "./dist/src/optimizer/runtime-assertions.js"
    },
    "./experimental/corsa/callables": {
      "types": "./dist/src/frontends/corsa/corsa-callable-frontend.d.ts",
      "import": "./dist/src/frontends/corsa/corsa-callable-frontend.js"
    },
    "./experimental/build/corsa": {
      "types": "./dist/src/project/corsa-build-output.d.ts",
      "import": "./dist/src/project/corsa-build-output.js"
    },
    "./experimental/workspace/corsa": {
      "types": "./dist/src/project/corsa-workspace-summaries.d.ts",
      "import": "./dist/src/project/corsa-workspace-summaries.js"
    }
  },
  "bin": {
    "uneffect": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples/*.ts",
    "skills",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "tsx ci/run-test-tiers.ts",
    "bench": "vitest bench --run",
    "check": "tsc -p tsconfig.json --noEmit && tsx ci/run-test-tiers.ts",
    "prepack": "pnpm build",
    "smoke:corsa": "node ci/smoke-corsa-no-typescript.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@informalsystems/quint": ">=0.32.0 <0.33.0",
    "@oxlint/plugins": ">=1.80.0 <2.0.0",
    "corsa-oxlint": ">=1.12.4 <2.0.0",
    "oxlint": ">=1.80.0 <2.0.0",
    "typescript": ">=7.0.0 <8.0.0",
    "@typescript/typescript6": ">=6.0.2 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@typescript/typescript6": {
      "optional": true
    },
    "@informalsystems/quint": {
      "optional": true
    },
    "@oxlint/plugins": {
      "optional": true
    },
    "corsa-oxlint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "dependencies": {
    "effect": "^3.22.1",
    "oxc-parser": "^0.148.0",
    "valibot": "^1.4.2",
    "z3-solver": "^4.15.4"
  },
  "optionalDependencies": {
    "@corsa-bind/napi": "1.13.1",
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-darwin-x64": "7.0.2",
    "@typescript/typescript-linux-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2",
    "@typescript/typescript-win32-arm64": "7.0.2",
    "@typescript/typescript-win32-x64": "7.0.2"
  },
  "devDependencies": {
    "@corsa-bind/napi": "1.13.1",
    "@informalsystems/quint": "^0.32.0",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^24.0.0",
    "corsa-oxlint": "1.12.4",
    "oxlint": "1.80.0",
    "tsx": "^4.20.5",
    "typescript": "7.0.2",
    "@typescript/typescript6": "6.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.15.0"
}
